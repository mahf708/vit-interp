#!/bin/bash
# v3: v2 (1980-2009, diagnostics, ACE-style correctors in the loop, conv head, EMA, input noise)
# made stochastic (noise-conditioned LayerNorms, ACE2S) and trained on ACE's ensemble loss (CRPS + energy
# score, 2 members) instead of MSE;
# one-step training, then 4- and 8-step rollout fine-tuning, then the year-long evaluation.
#   cd ~/vit-interp-v3 && qsub -v RUN=vit3-p4-d384-l8 scripts/train_v3.pbs
# Submit from the checkout whose code should run (this branch's worktree): it runs with the shared
# venv (~/vit-interp/.venv) and PYTHONPATH set to the submit directory, so this code wins.
#PBS -A E3SM
#PBS -q gpu
#PBS -N vit3-train
#PBS -l select=1:ngpus=4
#PBS -l walltime=20:00:00
#PBS -j oe
#PBS -o logs/
set -euo pipefail
cd "${PBS_O_WORKDIR:-$HOME/vit-interp}"
RUN=${RUN:?set RUN}
D=/lcrc/globalscratch/ac.ngmahfouz/vit-interp/data-v2
O=/lcrc/globalscratch/ac.ngmahfouz/vit-interp/runs/$RUN
mkdir -p "$O"
{ git rev-parse HEAD; git status --short; } > "$O/VERSION" 2>/dev/null || true
export OMP_NUM_THREADS=4
export PYTHONPATH=$PWD${PYTHONPATH:+:$PYTHONPATH}
BIN=${VENV:-$HOME/vit-interp/.venv}/bin
$BIN/python -c "import vit_interp, sys; assert vit_interp.__file__.startswith('$PWD'), vit_interp.__file__"
COMMON="--data $D --train-years ${TRAIN_YEARS:-1980-2009} --val-years 2010-2010 --head-conv 3 --ema 0.999
  --corrector dry_air,positive,moisture,energy --unaccounted-heating ${HEAT:-0.6}
  --noise-dim ${NOISE_DIM:-32} --noise-type ${NOISE_TYPE:-gaussian} --loss ensemble --n-ensemble ${NENS:-2}
  --crps-weight 0.9 --energy-weight 0.1"
T="$BIN/torchrun --standalone --nproc-per-node 4 -m vit_interp.train"

echo "$(date) v3 stage 1: one-step"
$T --out "$O/stage1" $COMMON --batch 8 --lr 3e-4 --epochs ${EPOCHS1:-60} --input-noise 0.02 \
  --walltime-min ${WALL1:-600}
echo "$(date) v3 ft4: 4-step rollouts"
$T --out "$O/ft4" $COMMON --init "$O/stage1/best.pt" --n-steps 4 --batch 4 --lr 5e-5 --warmup 200 \
  --epochs ${EPOCHS4:-6} --rollout-steps 40 --input-noise 0.01 --walltime-min ${WALL4:-240}
echo "$(date) v3 ft8: 8-step rollouts"
$T --out "$O/ft8" $COMMON --init "$O/ft4/best.pt" --n-steps 8 --batch 2 --lr 2e-5 --warmup 100 \
  --epochs ${EPOCHS8:-3} --rollout-steps 40 --walltime-min ${WALL8:-300}
echo "$(date) eval"
$BIN/python -m vit_interp.evaluate "$O/ft8/best.pt" "$O/eval-ft8" --data $D --members ${NENS_EVAL:-4} --seed 0 || true
echo "$(date) done"
