#!/bin/bash
# v5: v4 continued against the seam instability: ACE's spectral energy score (0.1) with CRPS (0.9),
# rollouts of 4-24 steps with the last-step gradient; SMOOTH=1 also trains with the seam filter in the loop.
#   cd ~/vit-interp-v5 && qsub -v RUN=vit5a-p4-d384-l8 scripts/train_v5.pbs
#   cd ~/vit-interp-v5 && qsub -v RUN=vit5b-p4-d384-l8,SMOOTH=1 scripts/train_v5.pbs
#PBS -A E3SM
#PBS -q gpu
#PBS -N vit5-train
#PBS -l select=1:ngpus=4
#PBS -l walltime=11:00:00
#PBS -j oe
#PBS -o logs/
set -euo pipefail
cd "$(realpath "${PBS_O_WORKDIR:-$HOME/vit-interp-v5}")"
RUN=${RUN:?set RUN}
INIT=${INIT:-/lcrc/globalscratch/ac.ngmahfouz/vit-interp/runs/vit4-p4-d384-l8/long/best.pt}
D=/lcrc/globalscratch/ac.ngmahfouz/vit-interp/data-v2
O=/lcrc/globalscratch/ac.ngmahfouz/vit-interp/runs/$RUN
mkdir -p "$O"
{ git rev-parse HEAD; git status --short; echo "init $INIT smooth ${SMOOTH:-0}"; } > "$O/VERSION" 2>/dev/null || true
export OMP_NUM_THREADS=4
export PYTHONPATH=$(pwd -P)${PYTHONPATH:+:$PYTHONPATH}
BIN=${VENV:-$HOME/vit-interp/.venv}/bin
$BIN/python -c "import vit_interp, sys; assert vit_interp.__file__.startswith('$(pwd -P)'), vit_interp.__file__"
SM=""; EF=""
if [ "${SMOOTH:-0}" = 1 ]; then SM="--smooth-kc 60 --smooth-lat 1"; EF="--filter 60 --shapiro 1"; fi
echo "$(date) v5 $RUN: energy ${EW:-0.1}, ${MIN:-4}-${MAX:-24} steps, smooth ${SMOOTH:-0}"
$BIN/torchrun --standalone --nproc-per-node 4 -m vit_interp.train --out "$O/long" \
  --data $D --train-years 1980-2009 --val-years 2010-2010 --head-conv 3 --ema 0.999 \
  --corrector dry_air,positive,moisture,energy --unaccounted-heating 0.6 \
  --noise-dim 32 --noise-type gaussian --loss ensemble --n-ensemble 2 \
  --crps-weight ${CW:-0.9} --energy-weight ${EW:-0.1} $SM \
  --init "$INIT" --n-steps ${MAX:-24} --min-steps ${MIN:-4} --grad-last-only --batch ${BATCH:-2} \
  --lr ${LR:-5e-5} --warmup 200 --epochs ${EPOCHS:-4} --input-noise 0.01 --rollout-steps 40 \
  --walltime-min ${WALL:-580}
echo "$(date) eval"
$BIN/python -m vit_interp.evaluate "$O/long/best.pt" "$O/eval-long" --data $D --members ${MEMBERS:-4} --seed 0 $EF || true
[ -n "$EF" ] || $BIN/python -m vit_interp.evaluate "$O/long/best.pt" "$O/eval-long-filter" --data $D --members ${MEMBERS:-4} --seed 0 --filter 60 --shapiro 1 || true
echo "$(date) done"
