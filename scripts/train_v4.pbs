#!/bin/bash
# v4: v3 (stochastic, CRPS) trained on long rollouts: each batch a random length in [MIN, MAX] 6-h steps,
# gradient on the last step only (pushforward / ACE's optimize_last_step_only); then the year-long eval.
#   cd ~/vit-interp-v4 && qsub -v RUN=vit4-p4-d384-l8,INIT=.../vit3-p4-d384-l8/stage1/best.pt scripts/train_v4.pbs
#PBS -A E3SM
#PBS -q gpu
#PBS -N vit4-train
#PBS -l select=1:ngpus=4
#PBS -l walltime=11:00:00
#PBS -j oe
#PBS -o logs/
set -euo pipefail
cd "${PBS_O_WORKDIR:-$HOME/vit-interp-v4}"
RUN=${RUN:?set RUN}; INIT=${INIT:?set INIT}
D=/lcrc/globalscratch/ac.ngmahfouz/vit-interp/data-v2
O=/lcrc/globalscratch/ac.ngmahfouz/vit-interp/runs/$RUN
mkdir -p "$O"
{ git rev-parse HEAD; git status --short; echo "init $INIT"; } > "$O/VERSION" 2>/dev/null || true
export OMP_NUM_THREADS=4
export PYTHONPATH=$PWD${PYTHONPATH:+:$PYTHONPATH}
BIN=${VENV:-$HOME/vit-interp/.venv}/bin
$BIN/python -c "import vit_interp, sys; assert vit_interp.__file__.startswith('$PWD'), vit_interp.__file__"
echo "$(date) v4 long rollouts: ${MIN:-4}-${MAX:-16} steps, last-step gradient, ${EPOCHS:-4} epochs"
$BIN/torchrun --standalone --nproc-per-node 4 -m vit_interp.train --out "$O/long" \
  --data $D --train-years 1980-2009 --val-years 2010-2010 --head-conv 3 --ema 0.999 \
  --corrector dry_air,positive,moisture,energy --unaccounted-heating 0.6 \
  --noise-dim 32 --noise-type gaussian --loss ensemble --n-ensemble 2 --crps-weight 1.0 --energy-weight 0.0 \
  --init "$INIT" --n-steps ${MAX:-16} --min-steps ${MIN:-4} --grad-last-only --batch ${BATCH:-2} \
  --lr ${LR:-5e-5} --warmup 200 --epochs ${EPOCHS:-4} --input-noise 0.01 --rollout-steps 40 \
  --walltime-min ${WALL:-600}
echo "$(date) eval"
$BIN/python -m vit_interp.evaluate "$O/long/best.pt" "$O/eval-long" --data $D --members ${MEMBERS:-4} --seed 0 || true
echo "$(date) done"
